# 複製為 .env 後再填。此檔只列變數名與說明，不含任何實際值。

# HTTP 連接埠
PORT=

# 排行榜 SQLite 目錄（容器內通常掛到 /app/data）
DATA_DIR=

# 為 true 時從 CF-Connecting-IP（優先）或 X-Forwarded-For 第一值取訪客 IP。
# Cloudflare Tunnel 後方開；本機、區域網路或 Tailscale 直連不要開。
TRUST_PROXY=

# 下列限額可覆蓋程式預設；部署實際值不必與倉庫預設相同。
MAX_ROOMS=
MAX_ROOMS_PER_IP=
MAX_SOCKETS_PER_IP=
CREATE_PER_MIN=
HTTP_PER_MIN=
MAX_CLIENTS=
RATE_LIMIT=
MAX_PAYLOAD=
JOIN_IDLE_MS=
MAX_QUEUE_PER_IP=
QUEUE_IDLE_MS=
ROOM_TTL_MS=
RECONNECT_MS=
STATS_MS=
